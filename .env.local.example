# Anthropic API key for Claude AI
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the default Claude model used for question generation
ANTHROPIC_MODEL=claude-opus-4-8

# Deepgram API key for speech-to-text transcription
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ElevenLabs API key for text-to-speech prompt playback
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: override the default ElevenLabs voice/model/output format
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
